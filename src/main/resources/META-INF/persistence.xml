<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_1.xsd"
             version="3.1">

    <persistence-unit name="eDiagnose" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>com.example.models.User</class>
        <class>com.example.models.Patient</class>
        <class>com.example.models.Generaliste</class>
        <class>com.example.models.Infirmier</class>
        <class>com.example.models.Specialiste</class>

        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://localhost:5432/ediagnose"/>
            <property name="jakarta.persistence.jdbc.user" value="kaiser"/>
            <property name="jakarta.persistence.jdbc.password" value="kaiser"/>

            <property name="jakarta.persistence.schema-generation.database.action" value="none"/>

            <property name="hibernate.show_sql" value="false"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>

</persistence>
